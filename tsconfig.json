{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

   "module": "commonjs",
   "target": "ES2020",
   "moduleResolution": "node",

    "types": ["node"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}